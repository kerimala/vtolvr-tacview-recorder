<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PathMap>$(MSBuildProjectDirectory)=/_/src</PathMap>
    <VTOLVRPath Condition="'$(VTOLVRPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\VTOL VR</VTOLVRPath>
    <ModLoaderPath Condition="'$(ModLoaderPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\VTOL VR Mod Loader</ModLoaderPath>
    <ModDeployPath Condition="'$(ModDeployPath)' == ''">$(VTOLVRPath)\@Mod Loader\Mods\VTOLVRTacviewSPRecorder</ModDeployPath>
    <DeployMod Condition="'$(DeployMod)' == ''">false</DeployMod>
    <TestPackageRoot>$(MSBuildProjectDirectory)\artifacts\test-package\VTOLVRTacviewSPRecorder</TestPackageRoot>
    <WorkshopStagingRoot>$(MSBuildProjectDirectory)\artifacts\workshop-staging\VTOLVRTacviewSPRecorder</WorkshopStagingRoot>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <EmbeddedResource Include="tacview\Tacview.VTOLVR.PlayerAircraft.xml" LogicalName="VTOLVRTacviewSPRecorder.Tacview.PlayerAircraft.xml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(ModLoaderPath)\Managed\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ModLoader.Framework">
      <HintPath>$(ModLoaderPath)\Managed\ModLoader.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SteamQueries.Models">
      <HintPath>$(ModLoaderPath)\Managed\SteamQueries.Models.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp" Publicize="True">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TerrainModule">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\UnityEngine.TerrainModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAssetBundleModule">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\UnityEngine.UnityWebRequestAssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Valve.Newtonsoft.Json">
      <HintPath>$(VTOLVRPath)\VTOLVR_Data\Managed\Valve.Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="DeployToVTOLVR" AfterTargets="Build" Condition="'$(DeployMod)' == 'true'">
    <MakeDir Directories="$(ModDeployPath)" />
    <Copy SourceFiles="$(ProjectDir)item.json;$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModDeployPath)" />
  </Target>
  <Target Name="ValidateTestPackageProperties">
    <Error Condition="'$(Configuration)' != 'Release'" Text="CreateTestPackage requires Configuration=Release." />
    <Error Condition="'$(DeployMod)' != 'false'" Text="CreateTestPackage requires DeployMod=false." />
  </Target>
  <Target Name="CreateTestPackage" DependsOnTargets="ValidateTestPackageProperties;Build">
    <RemoveDir Directories="$(TestPackageRoot)" />
    <MakeDir Directories="$(TestPackageRoot)" />
    <ItemGroup>
      <TestPackageFiles Include="$(TargetPath)" />
      <TestPackageFiles Include="$(ProjectDir)item.json" />
      <TestPackageFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(TestPackageFiles)" DestinationFolder="$(TestPackageRoot)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Created private test package at $(TestPackageRoot)" />
  </Target>
  <Target Name="ValidateWorkshopStagingProperties">
    <Error Condition="'$(Configuration)' != 'Release'" Text="CreateWorkshopStaging requires Configuration=Release." />
    <Error Condition="'$(DeployMod)' != 'false'" Text="CreateWorkshopStaging requires DeployMod=false." />
  </Target>
  <Target Name="CreateWorkshopStaging" DependsOnTargets="ValidateWorkshopStagingProperties;Build">
    <RemoveDir Directories="$(WorkshopStagingRoot)" />
    <MakeDir Directories="$(WorkshopStagingRoot)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(WorkshopStagingRoot)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Created PDB-free Workshop staging folder at $(WorkshopStagingRoot)" />
  </Target>
</Project>
